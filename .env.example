# Copy to .env, fill in locally, then restart the server. Never commit real keys.
PORT=2048
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Optional JSON request parameters (provider-specific). Core fields cannot be overridden.
# DeepSeek defaults to thinking disabled; other providers use their defaults.
LLM_EXTRA_BODY={}
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_API_KEY=
REQUEST_TIMEOUT_MS=30000
